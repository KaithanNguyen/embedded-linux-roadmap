root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = tab
indent_size = 8

[*.{cc,cpp,hpp}]
indent_style = space
indent_size = 4

[*.{py,sh}]
indent_style = space
indent_size = 4

[{Makefile,*.mk}]
indent_style = tab

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf
indent_style = space
indent_size = 4
